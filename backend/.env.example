# Application Environment
ENVIRONMENT=development
PROJECT_NAME="Farmer Voice AI Assistant Backend"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=farmervoice

# SQLALCHEMY Database URL fallback (or set directly)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/farmervoice

# JWT Security
SECRET_KEY=super-secret-key-change-in-production-32bytesmin
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:19006,http://localhost:8081,exp://localhost:19000
